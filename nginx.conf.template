server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Oberfläche
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # Einstellungen für die Oberfläche (Spotify Client ID aus der Datei .env)
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"spotifyClientId":"${SPOTIFY_CLIENT_ID}"}';
    }

    # Musikserver-Schnittstelle (Subsonic/OpenSubsonic) an Navidrome weiterreichen
    location /rest/ {
        proxy_pass http://navidrome:4533;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;          # Musik direkt durchstreamen
        proxy_read_timeout 3600s;
    }
    location /share/ {
        proxy_pass http://navidrome:4533;
        proxy_set_header Host $host;
    }
}
