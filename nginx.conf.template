server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Oberfläche
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # Einstellungen für die Oberfläche (Spotify Client ID aus der Datei .env)
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"spotifyClientId":"${SPOTIFY_CLIENT_ID}"}';
    }

    # Zertifikat der eigenen HTTPS-Zertifizierungsstelle (Caddy) zum Installieren auf iPhone und Mac
    # (wird von Caddy geliefert; über eine Variable, damit nginx auch startet, solange Caddy noch fehlt)
    location = /zertifikat.crt {
        resolver 127.0.0.11 valid=30s;
        set $caddy http://https:8081;
        proxy_pass $caddy;
    }

    # App: Manifest und Service Worker nie veraltet ausliefern
    location = /manifest.webmanifest { default_type application/manifest+json; add_header Cache-Control "no-cache"; }
    location = /sw.js { add_header Cache-Control "no-cache"; }

    # Musikserver-Schnittstelle (Subsonic/OpenSubsonic) an Navidrome weiterreichen
    location /rest/ {
        proxy_pass http://navidrome:4533;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;          # Musik direkt durchstreamen
        proxy_read_timeout 3600s;
    }
    location /share/ {
        proxy_pass http://navidrome:4533;
        proxy_set_header Host $host;
    }
}
