# Kopiere diese Datei nach ".env" und trage deine Werte ein.

# Ordner mit den FLAC-Alben auf dem Server (auch mit Unterordnern wie CD1/CD2)
FLAC_DIR=/mnt/musik

# Ordner mit den MP3-Dateien (Interpret/Titel). Leer lassen, solange nur FLAC genutzt wird.
# MP3_DIR=

# Benutzer-/Gruppen-ID, die die Musik lesen darf (Ausgabe von: id -u  bzw.  id -g)
PUID=1000
PGID=1000

# Port im Heimnetz
PORT=8484

# Alle wie viele Stunden nach neuer Musik gesucht wird (0 = nur per Knopf)
RESCAN_HOURS=6

# Spotify (kommt im nächsten Schritt): Client-ID der Spotify-Developer-App
SPOTIFY_CLIENT_ID=
