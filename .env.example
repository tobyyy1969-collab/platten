# Kopiere diese Datei nach ".env" und passe die Werte an.

# Ordner mit deinen FLAC-Alben auf dem Server
MUSIC_DIR=/srv/musik

# Benutzer-/Gruppen-ID, unter der Navidrome läuft (Ausgabe von: id -u  bzw.  id -g)
PUID=1000
PGID=1000

# Adresse, unter der du den Server im Heimnetz erreichst (IP oder Name), z. B. 192.168.178.20
# Daraus wird die HTTPS-Adresse für Spotify: https://SERVER_ADDRESS:8443
SERVER_ADDRESS=192.168.178.20

# Spotify Client ID (von developer.spotify.com/dashboard). Kann auch in der Oberfläche eingetragen werden.
SPOTIFY_CLIENT_ID=

# Ports im Heimnetz
WEB_PORT=8080
NAVIDROME_PORT=4533
HTTPS_PORT=8443

# Optional: Last.fm-API-Schlüssel für Künstlerbilder (https://www.last.fm/api/account/create)
LASTFM_APIKEY=
LASTFM_SECRET=
