# HTTPS im Heimnetz. Spotify erlaubt Anmeldung und Wiedergabe nur über HTTPS.
# Caddy erzeugt dafür ein eigenes Zertifikat (lokale Zertifizierungsstelle).
{
	local_certs
	skip_install_trust
	auto_https disable_redirects
	# Browser schicken bei IP-Adressen keinen Namen mit; dann dieses Zertifikat verwenden
	default_sni {$SERVER_ADDRESS}
}

https://{$SERVER_ADDRESS}:8443 {
	tls internal
	reverse_proxy web:80 {
		flush_interval -1
	}
}

# Nur intern (für nginx): das öffentliche Stammzertifikat zum Herunterladen unter http://SERVER:8080/zertifikat.crt
http://:8081 {
	handle /zertifikat.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=\"Plattenregal-Zertifikat.crt\""
		file_server
	}
	respond 404
}
